# ========== 语言大模型（LLM）配置 ==========
# 必填：模型地址、API Key、模型名
# 推荐服务商：
#   DeepSeek:  https://api.deepseek.com/v1  /  deepseek-chat
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1  /  qwen-plus
#   智谱GLM:   https://open.bigmodel.cn/api/paas/v4  /  glm-4-flash
#   Kimi:      https://api.moonshot.cn/v1  /  moonshot-v1-8k
#   OpenAI:    https://api.openai.com/v1  /  gpt-4o-mini
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY="在此填入你的API Key"
LLM_MODEL="deepseek-chat"

# ========== 图像模型配置（可选）==========
# 留空则仅生成步骤卡片 / Prompt，方便复制到其它图生图工具
# 推荐服务商：
#   OpenAI:           https://api.openai.com/v1  /  gpt-image-1  /  1792x1024
#   硅基流动:          https://api.siliconflow.cn/v1  /  Kwai-Kolors/Kolors  /  1024x1024
#   通义万相:          https://dashscope.aliyuncs.com/compatible-mode/v1  /  wanx2.1-t2i-turbo  /  1792x1024
#   火山方舟:          https://ark.cn-beijing.volces.com/api/v3            /  ep-xxxxxxxx（推理接入点ID） /  1792x1024
# 横版（如 1792x1024）更适合「全流程」这种多步骤横向排布的插画
IMG_BASE_URL=""
IMG_API_KEY=""
IMG_MODEL=""
IMG_SIZE="1792x1024"
